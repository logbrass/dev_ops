{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 38,
  "tags": ["jarvis", "canary"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "timepicker": {},
  "title": "Jarvis Canary",
  "uid": "jarvis-canary",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate by app version",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (version) (rate(http_requests_total{job=~\".*jarvis-web.*\"}[1m]))",
          "legendFormat": "{{version}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx rate (across versions)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\".*jarvis-web.*\", status=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=~\".*jarvis-web.*\"}[1m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "type": "stat",
      "title": "Rollout Phase",
      "id": 4,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "argorollouts_rollout_info{namespace=\"jarvis\", rollout=\"jarvis-web-jarvis-web\"}",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "Healthy": { "color": "green", "index": 0 },
                "Progressing": { "color": "blue", "index": 1 },
                "Paused": { "color": "orange", "index": 2 },
                "Degraded": { "color": "red", "index": 3 }
              },
              "type": "value"
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Current Step",
      "id": 5,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "argorollouts_rollout_info{namespace=\"jarvis\", rollout=\"jarvis-web-jarvis-web\"}",
          "legendFormat": "{{step_index}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Analysis Runs",
      "id": 6,
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "argorollouts_analysis_run_info{namespace=\"jarvis\"}",
          "legendFormat": "{{analysisrun}} - {{phase}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "table"
          }
        }
      }
    }
